#Postgres
POSTGRES_USER=user
POSTGRES_PASSWORD=password
# Usado pelo servidor para conectar ao Postgres (opcional: sem ele usa o repo em memória).
DATABASE_URL=postgres://user:password@localhost:5432/telemetrygo

#Cassandra
CASSANDRA_HOSTS=localhost:9042

#Redis
REDIS_URL=localhost:6379

#rate limiting (0 desativa)
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=30
INGEST_RATE_LIMIT_RPS=1000
INGEST_RATE_LIMIT_BURST=10000

#auth
# Obrigatório: o servidor recusa subir com JWT_SECRET vazio. Use um valor longo e aleatório.
JWT_SECRET=secret

#server / database pool / jwt expiration
SERVER_PORT=8080
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m
JWT_ACCESS_EXPIRATION=10m
JWT_REFRESH_EXPIRATION=168h
PASSWORD_RESET_EXPIRATION=30m