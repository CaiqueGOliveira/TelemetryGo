#Postgres
POSTGRES_USER=user
POSTGRES_PASSWORD=password

#Cassandra
CASSANDRA_HOSTS=localhost:9042

#Redis
REDIS_URL=localhost:6379

#rate limiting (0 desativa)
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=30
INGEST_RATE_LIMIT_RPS=1000
INGEST_RATE_LIMIT_BURST=10000

#auth
# Obrigatório: o servidor recusa subir com JWT_SECRET vazio. Use um valor longo e aleatório.
JWT_SECRET=secret